#!/usr/bin/env python3
"""
dictate-ru — offline голосовая диктовка на русском языке для Linux.
Usage:
  dictate        — говори, по Ctrl+C выводит текст и копирует в буфер обмена
  dictate --no-copy  — только вывод в stdout
"""
import subprocess
import sys
import json
import signal
import os
import shutil
import re
import argparse

DEFAULT_MODEL = "vosk-model-small-ru-0.22"
MODEL_URL = "https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip"
SAMPLE_RATE = 16000
CHUNK_SIZE = 8000


def get_model_path():
    candidates = [
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "model"),
        os.path.expanduser(f"~/.local/share/vosk-models/{DEFAULT_MODEL}"),
        os.path.join(os.path.dirname(os.path.realpath(__file__)), DEFAULT_MODEL),
    ]
    for path in candidates:
        if os.path.isdir(path) and os.path.isdir(os.path.join(path, "graph")):
            return path
    return None


def get_term_width():
    try:
        return shutil.get_terminal_size().columns
    except Exception:
        return 80


# Track how many lines the previous preview occupied
_prev_lines = 0


def show_preview(text):
    """Show preview, clearing all previously written lines first."""
    global _prev_lines
    width = get_term_width()

    # Move up and clear each line from previous preview
    for _ in range(_prev_lines):
        sys.stderr.write("\033[A\033[2K")
    sys.stderr.write("\r\033[2K")

    # Truncate to show only last `width - 2` chars (with … prefix if truncated)
    display = text
    max_chars = width - 2
    if len(display) > max_chars:
        display = "…" + display[-(max_chars - 1):]

    sys.stderr.write(f" {display}")
    sys.stderr.flush()

    # Calculate how many lines this output occupies (0 = fits in one line)
    _prev_lines = len(f" {display}") // width


def punctuate(text):
    """Add punctuation to raw vosk output."""
    if not text:
        return text

    # Words before which a comma is usually placed
    comma_words = [
        "что", "чтобы", "который", "которая", "которое", "которые",
        "потому что", "так как", "если", "когда", "где", "куда",
        "но", "однако", "а также", "то есть", "причём", "притом",
        "хотя", "пока", "поскольку",
    ]
    # Sort by length descending so "потому что" matches before "что"
    comma_words.sort(key=len, reverse=True)

    for word in comma_words:
        # Add comma before the word if preceded by a non-punctuation char
        pattern = rf"(\w)\s+({re.escape(word)})\b"
        text = re.sub(
            pattern,
            lambda m: f"{m.group(1)}, {m.group(2)}",
            text,
            flags=re.IGNORECASE,
        )

    # Sentence starters — put period before them and capitalize
    sentence_starters = [
        "во-первых", "во-вторых", "в-третьих",
        "потом", "затем", "далее", "наконец",
    ]
    for word in sentence_starters:
        pattern = rf"(\w[,]?)\s+({re.escape(word)})\b"
        text = re.sub(
            pattern,
            lambda m: f"{m.group(1)}. {m.group(2)[0].upper()}{m.group(2)[1:]}",
            text,
            flags=re.IGNORECASE,
        )

    # Capitalize first letter
    text = text[0].upper() + text[1:]

    # Period at the end
    if text[-1] not in ".!?":
        text += "."

    # Fix double punctuation
    text = re.sub(r"[,]+", ",", text)
    text = re.sub(r"[.]+", ".", text)
    text = re.sub(r",\.", ".", text)

    return text


def has_wl_copy():
    return any(
        os.access(os.path.join(p, "wl-copy"), os.X_OK)
        for p in os.environ.get("PATH", "").split(":")
    )


def main():
    parser = argparse.ArgumentParser(description="Offline голосовая диктовка на русском")
    parser.add_argument("--no-copy", action="store_true", help="Не копировать в буфер обмена")
    parser.add_argument("--no-punct", action="store_true", help="Без автопунктуации")
    parser.add_argument("--model", type=str, help="Путь к Vosk модели")
    args = parser.parse_args()

    try:
        from vosk import Model, KaldiRecognizer, SetLogLevel
    except ImportError:
        print("Vosk не установлен. Установи: pip install vosk", file=sys.stderr)
        sys.exit(1)

    SetLogLevel(-1)

    model_path = args.model or get_model_path()
    if not model_path:
        print(f"Модель не найдена. Скачай: wget {MODEL_URL}", file=sys.stderr)
        sys.exit(1)

    sys.stderr.write("Загрузка...")
    sys.stderr.flush()
    model = Model(model_path)
    rec = KaldiRecognizer(model, SAMPLE_RATE)
    sys.stderr.write(" Говори! (Ctrl+C — готово)\n")
    sys.stderr.flush()

    proc = subprocess.Popen(
        ["parec", "--format=s16le", f"--rate={SAMPLE_RATE}", "--channels=1", "--latency-msec=100"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )

    copy_to_clipboard = not args.no_copy and has_wl_copy()
    use_punct = not args.no_punct
    all_text = []

    def on_exit(sig, frame):
        global _prev_lines
        proc.terminate()
        proc.wait()
        final = json.loads(rec.FinalResult())
        if final.get("text"):
            all_text.append(final["text"])
        raw = " ".join(all_text)
        text = punctuate(raw) if use_punct else raw
        # Clear preview
        for _ in range(_prev_lines):
            sys.stderr.write("\033[A\033[2K")
        sys.stderr.write("\r\033[2K")
        sys.stderr.flush()
        _prev_lines = 0
        if text:
            print(text, flush=True)
            if copy_to_clipboard:
                subprocess.run(["wl-copy", text], check=False)
                sys.stderr.write("(скопировано в буфер)\n")
        else:
            sys.stderr.write("(ничего не распознано)\n")
        sys.exit(0)

    signal.signal(signal.SIGINT, on_exit)
    signal.signal(signal.SIGTERM, on_exit)

    while True:
        data = proc.stdout.read(CHUNK_SIZE)
        if not data:
            break

        if rec.AcceptWaveform(data):
            result = json.loads(rec.Result())
            text = result.get("text", "")
            if text:
                all_text.append(text)
                show_preview(" ".join(all_text))
        else:
            partial = json.loads(rec.PartialResult())
            ptext = partial.get("partial", "")
            if ptext:
                preview = " ".join(all_text + [ptext]) if all_text else ptext
                show_preview(preview)


if __name__ == "__main__":
    main()
