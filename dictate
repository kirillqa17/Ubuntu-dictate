#!/usr/bin/env python3
"""
dictate-ru — offline голосовая диктовка на русском языке для Linux.
Usage:
  dictate        — говори, по Ctrl+C выводит текст и копирует в буфер обмена
  dictate --no-copy  — только вывод в stdout
"""
import subprocess
import sys
import json
import signal
import os
import shutil
import re
import argparse

DEFAULT_MODEL = "vosk-model-small-ru-0.22"
MODEL_URL = "https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip"
SAMPLE_RATE = 16000
CHUNK_SIZE = 8000


def get_model_path():
    candidates = [
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "model"),
        os.path.expanduser(f"~/.local/share/vosk-models/{DEFAULT_MODEL}"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), DEFAULT_MODEL),
    ]
    for path in candidates:
        if os.path.isdir(path) and os.path.isdir(os.path.join(path, "graph")):
            return path
    return None


def get_term_width():
    try:
        return shutil.get_terminal_size().columns
    except Exception:
        return 80


def clear_line():
    """Clear current line using ANSI escape."""
    sys.stderr.write("\033[2K\r")
    sys.stderr.flush()


def show_preview(text):
    """Show truncated preview that fits in one terminal line."""
    width = get_term_width() - 4
    display = text[:width] if len(text) > width else text
    clear_line()
    sys.stderr.write(f"  {display}")
    sys.stderr.flush()


def punctuate(text):
    """Add basic punctuation to raw vosk output."""
    if not text:
        return text
    # Capitalize first letter
    text = text[0].upper() + text[1:]
    # Add period at the end if no punctuation
    if text and text[-1] not in ".!?":
        text += "."
    # Capitalize after sentence markers (keywords that usually start new sentences)
    sentence_starters = [
        "во-первых", "во-вторых", "в-третьих", "потом", "затем",
        "также", "ещё", "далее", "кроме того", "наконец",
    ]
    for word in sentence_starters:
        pattern = rf"(\S)\s+({word})"
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            text = re.sub(
                pattern,
                lambda m: f"{m.group(1)}. {m.group(2)[0].upper()}{m.group(2)[1:]}",
                text,
                flags=re.IGNORECASE,
            )
    return text


def has_wl_copy():
    return any(
        os.access(os.path.join(p, "wl-copy"), os.X_OK)
        for p in os.environ.get("PATH", "").split(":")
    )


def main():
    parser = argparse.ArgumentParser(description="Offline голосовая диктовка на русском")
    parser.add_argument("--no-copy", action="store_true", help="Не копировать в буфер обмена")
    parser.add_argument("--no-punct", action="store_true", help="Без автопунктуации")
    parser.add_argument("--model", type=str, help="Путь к Vosk модели")
    args = parser.parse_args()

    try:
        from vosk import Model, KaldiRecognizer, SetLogLevel
    except ImportError:
        print("Vosk не установлен. Установи: pip install vosk", file=sys.stderr)
        sys.exit(1)

    SetLogLevel(-1)

    model_path = args.model or get_model_path()
    if not model_path:
        print(f"Модель не найдена. Скачай: wget {MODEL_URL}", file=sys.stderr)
        sys.exit(1)

    sys.stderr.write("Загрузка...")
    sys.stderr.flush()
    model = Model(model_path)
    rec = KaldiRecognizer(model, SAMPLE_RATE)
    sys.stderr.write(" Говори! (Ctrl+C — готово)\n")
    sys.stderr.flush()

    proc = subprocess.Popen(
        ["parec", "--format=s16le", f"--rate={SAMPLE_RATE}", "--channels=1", "--latency-msec=100"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )

    copy_to_clipboard = not args.no_copy and has_wl_copy()
    use_punct = not args.no_punct
    all_text = []

    def on_exit(sig, frame):
        proc.terminate()
        proc.wait()
        final = json.loads(rec.FinalResult())
        if final.get("text"):
            all_text.append(final["text"])
        raw = " ".join(all_text)
        text = punctuate(raw) if use_punct else raw
        clear_line()
        if text:
            print(text, flush=True)
            if copy_to_clipboard:
                subprocess.run(["wl-copy", text], check=False)
                sys.stderr.write("(скопировано в буфер)\n")
        else:
            sys.stderr.write("(ничего не распознано)\n")
        sys.exit(0)

    signal.signal(signal.SIGINT, on_exit)
    signal.signal(signal.SIGTERM, on_exit)

    while True:
        data = proc.stdout.read(CHUNK_SIZE)
        if not data:
            break

        if rec.AcceptWaveform(data):
            result = json.loads(rec.Result())
            text = result.get("text", "")
            if text:
                all_text.append(text)
                show_preview(" ".join(all_text))
        else:
            partial = json.loads(rec.PartialResult())
            ptext = partial.get("partial", "")
            if ptext:
                preview = " ".join(all_text + [ptext]) if all_text else ptext
                show_preview(preview)


if __name__ == "__main__":
    main()
